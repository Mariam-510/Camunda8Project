    {
      "type": "image",
      "layout": {
        "row": "Row_1infsgs",
        "columns": null
      },
      "id": "Field_1cw8iwt",
      "source": "=\"http://localhost:8080/v2/documents/\" \n+ NationalIdImage[1].documentId \n+ \"?storeId=\" \n+ NationalIdImage[1].storeId \n+ \"&contentHash=\" \n+ NationalIdImage[1].contentHash",
      "conditional": {
        "hide": "=not (exists(NationalIdImage[1].documentId) and NationalIdImage[1].documentId != null and NationalIdImage[1].documentId != \"\")"
      }
    },
    {
      "label": "NationalIdImage Errors",
